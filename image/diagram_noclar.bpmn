<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_AskReport" targetNamespace="http://rag-postgres/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.13.2">
  <bpmn:collaboration id="Collaboration_AskReport" name="Обработка пользовательского запроса в PostgreSQL RAG Assistant">
    <bpmn:participant id="Participant_Assistant" name="PostgreSQL RAG Assistant" processRef="Process_Assistant" />
    <bpmn:textAnnotation id="TextAnnotation_0uru5in">
      <bpmn:text>да</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:dataStore id="DataStore_pgvector" name="PostgreSQL / pgvector" />
  <bpmn:process id="Process_Assistant" name="PostgreSQL RAG Assistant" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Assistant">
      <bpmn:lane id="Lane_RAG" name="RAG pipeline">
        <bpmn:flowNodeRef>Task_RetrievalRerank</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_EvidenceEnough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateAnswer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateTutorial</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ResponseMode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LimitedAnswer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ResultMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Backend" name="FastAPI и AskOrchestrationService">
        <bpmn:flowNodeRef>Task_VersionError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestValidation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_VersionSupported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareQuery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SaveResponse</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Client" name="Пользователь и Frontend">
        <bpmn:flowNodeRef>Start_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InputAndSend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShowAnswer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShowError</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Request" />
    <bpmn:task id="Task_VersionError" name="Сохранить ошибочный запрос" />
    <bpmn:userTask id="Task_InputAndSend" name="Ввести и отправить запрос" />
    <bpmn:task id="Task_RequestValidation" name="POST /api/ask: валидация запроса и версия">
      <bpmn:outgoing>Flow_0zfkgkb</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_VersionSupported" name="Версия?">
      <bpmn:incoming>Flow_0zfkgkb</bpmn:incoming>
      <bpmn:outgoing>Flow_1ptx1v3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_PrepareQuery" name="Анализ, корпуса и embedding">
      <bpmn:incoming>Flow_1ptx1v3</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Task_RetrievalRerank" name="Retrieval и rerank">
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0u2tgyr">
        <bpmn:targetRef>DSRef_pgvector</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:dataStoreReference id="DSRef_pgvector" name="PostgreSQL / pgvector" dataStoreRef="DataStore_pgvector" />
    <bpmn:exclusiveGateway id="GW_EvidenceEnough" name="Evidence достаточно?" />
    <bpmn:serviceTask id="Task_GenerateAnswer" name="Groq: текстовый ответ" />
    <bpmn:serviceTask id="Task_GenerateTutorial" name="Groq: tutorial-ответ" />
    <bpmn:exclusiveGateway id="GW_ResponseMode" name="Режим?" />
    <bpmn:task id="Task_LimitedAnswer" name="Ограниченный ответ" />
    <bpmn:exclusiveGateway id="GW_ResultMerge" />
    <bpmn:task id="Task_SaveResponse" name="Сохранить историю и AskResponse" />
    <bpmn:task id="Task_ShowAnswer" name="Показать ответ и источники" />
    <bpmn:endEvent id="End_Success" name="Ответ получен" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Request" targetRef="Task_InputAndSend" />
    <bpmn:sequenceFlow id="Flow_4_no" name="нет" sourceRef="GW_VersionSupported" targetRef="Task_VersionError" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_VersionError" targetRef="Task_ShowError" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_InputAndSend" targetRef="Task_RequestValidation" />
