    <bpmn:sequenceFlow id="Flow_14_no" name="нет" sourceRef="GW_EvidenceEnough" targetRef="Task_LimitedAnswer" />
    <bpmn:sequenceFlow id="Flow_16_yes" name="да" sourceRef="GW_EvidenceEnough" targetRef="GW_ResponseMode" />
    <bpmn:sequenceFlow id="Flow_17_sd" sourceRef="GW_ResponseMode" targetRef="Task_GenerateAnswer" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_GenerateAnswer" targetRef="GW_ResultMerge" />
    <bpmn:sequenceFlow id="Flow_18_tutorial" sourceRef="GW_ResponseMode" targetRef="Task_GenerateTutorial" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_GenerateTutorial" targetRef="GW_ResultMerge" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_LimitedAnswer" targetRef="GW_ResultMerge" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="GW_ResultMerge" targetRef="Task_SaveResponse" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_SaveResponse" targetRef="Task_ShowAnswer" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_ShowAnswer" targetRef="End_Success" />
    <bpmn:endEvent id="End_Error" name="Ошибка показана" />
    <bpmn:task id="Task_ShowError" name="Показать ошибку" />
    <bpmn:sequenceFlow id="Flow_1ptx1v3" sourceRef="GW_VersionSupported" targetRef="Task_PrepareQuery" />
  </bpmn:process>
